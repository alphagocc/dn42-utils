# /etc/dn42ctl/server.env
# 权限: 0600, owner: dn42ctl
#
# 生成 token: openssl rand -hex 32

DN42CTL_API_TOKEN=<替换为 admin token>
DN42CTL_CORS_ORIGINS=https://admin.dn42.example.com,https://peer.dn42.example.com

# auto-peer 向导页面的公开域名。Kioubit 认证响应中的 domain 字段按它比对,
# 留空则 /api/public/auto-peer/* 一律返回 503。
DN42CTL_AUTOPEER_DOMAIN=peer.dn42.example.com
